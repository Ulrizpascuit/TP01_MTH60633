# Backtesting

T_window <- 1000
level <- 0.95
n_backtest <- 1000

VaR_results <- list(sp500 = numeric(n_backtest), 
                    ftse100 = numeric(n_backtest))


# Boucle pour backtester
for (i in 1:n_backtest) {
  # Sélection des données pour la fenêtre de backtesting
  y_subset_sp500 <- log_rets_sp500[i:(i + T_window - 1)]
  y_subset_ftse100 <- log_rets_ftse100[i:(i + T_window - 1)]
  
  VaR_results$sp500[i] <- f_forecast_var(y = y_subset_sp500, level = level)$VaR
  VaR_results$ftse100[i] <- f_forecast_var(y = y_subset_ftse100, level = level)$VaR
  
  if (i %% 100 == 0) {
    cat("Backtesting progress: ", i, " out of ", n_backtest, "\n")
  }
}
  

# png (file = "VaR_Backtest_Plots")
par(mfrow = c(2, 1))

# Plot pour sp500
realized_sp500 <- as.numeric(log_rets_sp500[(T_window + 1):(T_window + n_backtest)])
plot(realized_sp500, type = "l", col = "blue", main = "Backtest SP500", ylab = "Log-rets", xlab = "Time")
lines(VaR_results$sp500, col = "red", lwd = 2, lty = 2)

# Plot pour ftse100
realized_ftse100 <- as.numeric(log_rets_ftse100[(T_window + 1):(T_window + n_backtest)])
plot(realized_ftse100, type = "l", col = "blue", main = "Backtest FTSE100", ylab = "Log-rets", xlab = "Time")
lines(VaR_results$ftse100, col = "red", lwd = 2, lty = 2)

